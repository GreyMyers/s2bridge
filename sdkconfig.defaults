CONFIG_IDF_TARGET="esp32s3"

# TinyUSB: one HID interface, no CDC
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=n

# Keep console on UART so USB is free for HID
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Needed later for NimBLE central role in phase 2
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# Phase 2: NimBLE central
# Default ATT MTU is 23, capping notifications at 20 bytes. Input reports
# are 63, so a larger MTU is mandatory.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# NimBLE pushes the app past the default 1MB factory partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
